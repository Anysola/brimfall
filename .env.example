# ---- Required ----

# Password for the dashboard (single user).
DASHBOARD_PASSWORD=change-me

# Signs the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Backblaze B2 application key (Application Keys page in B2).
# Use an application key, not the master key: B2's S3 API rejects the master key.
#   files only:        listBuckets, listFiles, readFiles, writeFiles, deleteFiles, shareFiles
#   + bucket settings: readBuckets, writeBuckets (create/delete: deleteBuckets)
#   + keys page:       listKeys, writeKeys, deleteKeys
B2_KEY_ID=
B2_APP_KEY=

# ---- Optional ----

# Bucket opened after sign-in (default: the first one).
# DEFAULT_BUCKET=my-bucket

# Public base URL per bucket, comma separated: bucket=https://base
# Copied links and previews use <base>/<key>. Without it, public buckets use B2's friendly URL.
# CDN_URLS=my-bucket=https://cdn.example.com

# Branding
APP_NAME=Brimfall
# LOGO_URL=https://example.com/logo.svg

# Interface language when the browser's language isn't supported (en, de, fr, tr, ja, …)
DEFAULT_LOCALE=en

# How long a sign-in lasts (hours). Changing DASHBOARD_PASSWORD or SESSION_SECRET signs everyone out.
SESSION_TTL_HOURS=168

# Header your reverse proxy sets to the real client IP, used for sign-in rate limiting:
# cf-connecting-ip behind Cloudflare, x-real-ip for nginx. When unset, the last X-Forwarded-For
# hop is used. Only set it if the app can be reached through that proxy alone.
# CLIENT_IP_HEADER=x-real-ip

# ---- Other S3-compatible storage ----
# Point the file manager at any S3 endpoint instead of B2 (MinIO, R2, Wasabi, RustFS…).
# Bucket settings and the keys page need the B2 native API and are hidden in this mode.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
